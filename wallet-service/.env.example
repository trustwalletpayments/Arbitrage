# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Keep the service-role key only on the private wallet-service host.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Extended public key for the dedicated custodial deposit wallet.
# Never commit a private key or seed phrase.
EVM_XPUB=replace_with_extended_public_key

# Internal provisioning API secret.
ADMIN_API_KEY=replace_with_long_random_secret

# EVM RPC endpoints. Configure only the networks you intend to activate.
ETHEREUM_RPC_URL=https://YOUR_ETHEREUM_RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://YOUR_POLYGON_RPC
ARBITRUM_RPC_URL=https://YOUR_ARBITRUM_RPC
OPTIMISM_RPC_URL=https://YOUR_OPTIMISM_RPC
BASE_RPC_URL=https://YOUR_BASE_RPC
AVALANCHE_RPC_URL=https://YOUR_AVALANCHE_RPC
FANTOM_RPC_URL=https://YOUR_FANTOM_RPC
CRONOS_RPC_URL=https://YOUR_CRONOS_RPC
LINEA_RPC_URL=https://YOUR_LINEA_RPC

# ERC-20 contract map. Use checksummed or valid EVM addresses.
# USDT defaults are documented here for the supported EVM networks.
# Base is intentionally omitted until the product explicitly supports the
# chosen USDT/USDT0 deployment instead of labeling an arbitrary token as USDT.
EVM_TOKEN_CONTRACTS_JSON={"ethereum":{"USDT":"0xdAC17F958D2ee523a2206206994597C13D831ec7"},"bsc":{"USDT":"0x55d398326f99059fF775485246999027B3197955"},"polygon":{"USDT":"0xc2132D05D31c914a87C6611C10748AEb04B58e8F"},"arbitrum":{"USDT":"0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9"},"optimism":{"USDT":"0x94b008aA00579c1307B0EF2c499aD98a8ce58e58"},"avalanche":{"USDT":"0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7"},"fantom":{"USDT":"0x049d68029688eabf473097a2fc38ef61633a3c7a"},"cronos":{"USDT":"0x66e428c3f67a68878562e79A0234c1F83c208770"},"linea":{"USDT":"0xa219439258ca9da29e9cc4ce5596924745e12b93"}}

# Legacy BSC USDT variable retained for the existing manual sweep path.
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Deposit confirmation settings.
CONFIRMATIONS_REQUIRED=15

# Sweep signer/treasury configuration.
# EVM_XPRIV must be the private extended key corresponding to EVM_XPUB.
EVM_XPRIV=replace_with_private_extended_key
TREASURY_PRIVATE_KEY=replace_with_treasury_private_key
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS
SWEEP_ENABLED=false

# Automatic sweep worker tuning.
# Worker checks configured token balances periodically and records each sweep in wallet_sweeps.
SWEEP_INTERVAL_MS=30000
SWEEP_MAX_ACCOUNTS_PER_RUN=50
# Optional token-unit floor. Leave empty to sweep any positive balance.
SWEEP_MIN_AMOUNT=

PORT=8080
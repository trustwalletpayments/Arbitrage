# Orbitex wallet-service environment template
# NEVER commit real private keys, mnemonics, xprvs, service-role keys, or treasury secrets.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
ADMIN_API_KEY=replace_with_long_random_secret

# EVM HD custody keys
EVM_XPUB=replace_with_extended_public_key
EVM_XPRIV=replace_with_private_extended_key

# Alchemy HTTP RPC URLs
